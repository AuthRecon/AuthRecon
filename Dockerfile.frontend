# Production frontend: build the React app, then serve the static bundle with
# an unprivileged nginx. The image holds only dist/ — no source, .git or .env.
# For hot-reload development use docker-compose.dev.yml (Vite dev server).

# Extra CA certificates for networks that inspect TLS (see certs/README.md).
# docker-compose.yml passes the repo's certs/ directory as the `certs` build
# context; this empty stage is the default for a plain `docker build`.
FROM scratch AS certs

FROM node:22-alpine AS build

# Trust any certificates in certs/ (none by default, then nothing changes).
# Alpine has no update-ca-certificates without apk, so append them to the
# bundle Node reads. This stage is discarded; the nginx image gets none of it.
RUN --mount=type=bind,from=certs,target=/tmp/extra-certs \
    set -e; \
    for f in /tmp/extra-certs/*.crt /tmp/extra-certs/*.pem; do \
        [ -f "$f" ] || continue; \
        grep -q "BEGIN CERTIFICATE" "$f" || { echo "certs/$(basename "$f") is not a PEM certificate (see certs/README.md)" >&2; exit 1; }; \
        { echo; tr -d '\r' < "$f"; } >> /etc/ssl/certs/ca-certificates.crt; \
    done
ENV NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt

WORKDIR /app

COPY package*.json ./
# Optional private npm registry (docker-compose.mirror.yml). The .npmrc is a
# BuildKit secret, so its token never reaches an image layer.
RUN --mount=type=secret,id=npmrc,target=/root/.npmrc \
    npm ci --no-audit --no-fund

COPY index.html vite.config.js postcss.config.js VERSION ./
COPY public ./public
COPY src ./src

# Browser-facing API URLs are baked in at build time (Vite inlines VITE_*).
# They are public endpoints, not secrets.
ARG VITE_API_URL=http://localhost:9000
ARG VITE_PORTAL_API=http://localhost:9000
ARG VITE_AUTHRECON_API=http://localhost:9000/apps/authrecon/api/v1
ARG VITE_WS_URL=ws://localhost:9000/ws
ENV VITE_API_URL=$VITE_API_URL \
    VITE_PORTAL_API=$VITE_PORTAL_API \
    VITE_AUTHRECON_API=$VITE_AUTHRECON_API \
    VITE_WS_URL=$VITE_WS_URL

RUN npm run build

# The CSP may connect only to the portal the UI was built for.
COPY docker/nginx-frontend.conf /tmp/nginx-frontend.conf
RUN sed -i "s#__CONNECT_SRC__#${VITE_API_URL} ${VITE_WS_URL}#g" /tmp/nginx-frontend.conf \
    && ! grep -q "__CONNECT_SRC__" /tmp/nginx-frontend.conf

FROM nginxinc/nginx-unprivileged:1.29-alpine

COPY --from=build /tmp/nginx-frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 5173
