# AuthRecon Suite - Docker Compose settings
# install.sh writes the real .env for you. To configure by hand, copy this file
# to .env, fill in every secret, and `chmod 600 .env`.

# Browser-facing API URLs (baked into the frontend build; not secrets) (Development - use localhost, Production - use your server IP/domain)
VITE_API_URL=http://localhost:9000
VITE_PORTAL_API=http://localhost:9000
VITE_AUTHRECON_API=http://localhost:9000/apps/authrecon/api/v1

# WebSocket URL
VITE_WS_URL=ws://localhost:9000/ws

# Backend Secrets (auto-generated by install.sh — see .env.secrets after running it)
# All of the following are REQUIRED: docker-compose.yml refuses to start any
# service with a missing value rather than falling back to a weak default.
# Generate each with: openssl rand -hex 32   (or -hex 16 for the DB passwords)
PORTAL_API_SECRET=CHANGE_ME_GENERATE_RANDOM_KEY
REDIS_PASSWORD=CHANGE_ME_GENERATE_RANDOM_KEY
# LoginLab (intentionally vulnerable test app) gets its own token, never PORTAL_API_SECRET
LOGINLAB_SERVICE_TOKEN=CHANGE_ME_GENERATE_RANDOM_KEY

POSTGRES_SUPERUSER_USER=postgres
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_GENERATE_RANDOM_KEY
PORTAL_DB_USER=portal
PORTAL_DB_PASSWORD=CHANGE_ME_GENERATE_RANDOM_KEY
AUTHRECON_DB_USER=authrecon
AUTHRECON_DB_PASSWORD=CHANGE_ME_GENERATE_RANDOM_KEY
