#!/bin/bash
#
# AuthRecon License Management Helper
#
# Usage:
#   ./license activate LICENSE-KEY
#   ./license status
#   ./license check
#   ./license deactivate
#   ./license install-id
#

# Get to project root
cd "$(dirname "$0")/../.." || exit 1

# Check if Docker is running
if ! docker compose ps authrecon-api >/dev/null 2>&1; then
    echo "❌ Error: AuthRecon containers are not running"
    echo ""
    echo "Start containers first:"
    echo "  docker compose up -d"
    exit 1
fi

# Run license command in container
docker compose exec authrecon-api python -m app.license.commands "$@"
