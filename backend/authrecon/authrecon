#!/usr/bin/env python3
"""
AuthRecon CLI wrapper

Usage:
    authrecon activate LICENSE-KEY
    authrecon status
    authrecon check
    authrecon deactivate
    authrecon install-id
    authrecon --version
"""
import sys
from pathlib import Path

# Add backend to path (but don't import app package yet)
backend_dir = Path(__file__).parent / "backend"
sys.path.insert(0, str(backend_dir))

if __name__ == "__main__":
    # Check for version flag
    if "--version" in sys.argv or "-v" in sys.argv:
        print("AuthRecon v1.0.0")
        sys.exit(0)

    # Check for help
    if "--help" in sys.argv or "-h" in sys.argv or len(sys.argv) == 1:
        print("""
AuthRecon - Self-Hosted Authentication Testing

Usage:
    authrecon activate LICENSE-KEY     Activate your license
    authrecon status                   Show license status
    authrecon check                    Validate license with server
    authrecon deactivate               Deactivate license on this machine
    authrecon install-id               Show installation ID

    authrecon --version                Show version
    authrecon --help                   Show this help

Licensing is optional and off by default; see ADMIN_GUIDE.md (Licensing).
        """)
        sys.exit(0)

    # Import standalone license CLI (doesn't require FastAPI main app)
    try:
        from app.license.commands import main as license_main
    except ImportError as e:
        print("\n❌ Error: Missing dependencies for license CLI")
        print(f"   {e}\n")
        print("To use the authrecon CLI, you have two options:\n")
        print("Option 1: Run via Docker (recommended):")
        print("  docker compose exec authrecon-api python -m app.license.commands activate YOUR-LICENSE-KEY\n")
        print("Option 2: Install dependencies:")
        print("  pip install httpx cryptography\n")
        print("For production deployments, dependencies are included in the Docker image.\n")
        sys.exit(1)

    # Run license CLI
    license_main()
